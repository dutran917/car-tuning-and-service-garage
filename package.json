{
  "name": "quocduong-auto-site",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.12.0 <23 || >=24.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/require-database-url.mjs && prisma db push",
    "storage:migrate:dry-run": "node scripts/migrate-local-uploads-to-supabase.mjs",
    "storage:migrate:apply": "node scripts/migrate-local-uploads-to-supabase.mjs --apply",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.22.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0"
  }
}
